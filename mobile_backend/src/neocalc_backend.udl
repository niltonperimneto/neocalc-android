namespace neocalc_backend {
    /// Structured history item for cleaner UI consumption
    dictionary HistoryItem {
        string expression;
        string result;
        u64 timestamp;
        boolean is_error;
    };

    interface Calculator {
        constructor();
        
        /// Smart input with validation
        string input(string text);
        
        /// Clear buffer to "0"
        string clear();
        
        /// Remove last character
        string backspace();
        
        /// Evaluate current expression
        string evaluate();
        
        /// Get current buffer content
        string get_buffer();
        
        /// Get structured history items
        sequence<HistoryItem> get_history();
        
        /// Get history as legacy strings (backward compatibility)
        sequence<string> get_history_strings();
        
        /// Get last successful result (for ANS key)
        string? get_last_result();
        
        /// Clear all history
        void clear_history();
        
        /// Convert to hexadecimal
        string convert_to_hex();
        
        /// Convert to binary
        string convert_to_bin();
        
        /// Convert to octal
        string convert_to_oct();
        
        /// Set fraction display mode
        void set_fraction_display(boolean enabled);
    };

    /// Parse GTK-style CSS theme file
    record<string, i64> parse_theme_css(string css);
};
